{
  "name": "workland",
  "version": "0.9.1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c magenta,cyan \"vite\" \"wait-on tcp:5199 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "release": "vite build && electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "Pedro Trindade",
  "license": "ISC",
  "description": "Área de trabalho em 3D",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pdfjs-dist": "^4.10.38",
    "postprocessing": "^6.36.4",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1",
    "zustand": "^4.5.5"
  },
  "type": "module",
  "build": {
    "appId": "br.com.gruponexus.workland",
    "productName": "Workland",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}*/**",
      "!node_modules/koffi/build/koffi/win32_{arm64,i386}/**",
      "!node_modules/koffi/src/**"
    ],
    "asarUnpack": [
      "electron/icons.ps1",
      "electron/media.ps1",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "PedroTrindade05",
      "repo": "workland",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Workland",
      "runAfterFinish": false
    }
  }
}
